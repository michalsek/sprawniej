# Values that supabase/config.toml reads with env(...). Copy this file to supabase/.env (it is not saved in git):
#   cp supabase/.env.example supabase/.env
# then run "bunx supabase config push".

# Where the app runs; sign-in sends people back here.
SPRAWNIEJ_SITE_URL=http://localhost:5173

# GitHub sign-in, once it is switched on. Don't write these here: export them in your shell for the one
# "supabase config push" command.
#   SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID
#   SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET
